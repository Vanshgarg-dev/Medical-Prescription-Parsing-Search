# ===== Groq LLM =====
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ===== PostgreSQL (matches compose.yaml) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ===== OpenRouter (used via LiteLLM in PostgreSQL for embeddings & completion) =====
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
OPENROUTER_COMPLETE_MODEL=google/gemma-4-31b-it:free

# ===== Supabase Storage =====
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key
SUPABASE_BUCKET=prescriptions
